{
  "expo": {
    "name": "TransitPro",
    "slug": "transitpro",
    "scheme": "transitpro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "TransitPro scans ticket and parcel QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TransitPro shares the bus position during a trip and proves where a parcel was delivered."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.ghost_kennel_02.transitpro"
    }
  }
}
