{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    // Shared response types. Only use `import type` from it (types disappear at runtime).
    "paths": { "@contracts/*": ["../contracts/*"] }
  },
  "include": ["src"]
}
