# Copy this file to .env and fill in your own values. Never commit .env.

# Local PostgreSQL (or a free Neon / Supabase / Railway database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transitpro?schema=public"

PORT=4000

# Any long random string. Used to sign login tokens.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed to call the API (web dashboard, Expo web)
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"
