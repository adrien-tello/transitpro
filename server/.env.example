# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string.
# Prisma cloud (Prisma Postgres): use the DIRECT connection string that starts with
# postgres:// (Console > your database > Connect), not the prisma+postgres:// one.
DATABASE_URL=""

PORT=4000

# Long random string that signs login sessions (64+ characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Comma-separated origins allowed to call the API with cookies (web dashboard, Expo web)
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"

# Google sign-in (optional for now). Google Cloud Console > APIs & Services > Credentials:
# the OAuth client IDs of the web app, the Android app and the iOS app, comma-separated.
GOOGLE_CLIENT_IDS=""

# Email through Gmail SMTP (free, ~500 emails/day, to any address).
# 1. Create the project Gmail account  2. Google account > Security > turn on 2-Step Verification
# 3. Security > App passwords > create one, paste the 16 letters below (spaces are fine)
# Leave both empty while developing: emails are printed in the server terminal.
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM_NAME="TransitPro"

# Web dashboard address (buttons in emails)
WEB_URL="http://localhost:5173"

# Photos on Cloudinary (cloudinary.com > Console > Dashboard: Cloud name, API Key, API Secret).
# Empty = photos are saved in server/uploads/ while developing.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mobile Money through Notch Pay (notchpay.co > Business Suite > Sandbox > Settings > API Keys).
# While developing, ONLY test keys (pk_test..., sk_test..., hsk_test...): no real money moves.
NOTCHPAY_PUBLIC_KEY=""
NOTCHPAY_PRIVATE_KEY=""
NOTCHPAY_HASH_KEY=""
PAYMENT_TIMEOUT_MINUTES=15

NODE_ENV="development"
